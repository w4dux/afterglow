{
  "name": "afterglow-stage",
  "productName": "Afterglow",
  "version": "2.6.0",
  "description": "Full-screen kinetic lyrics companion for Windows and Linux",
  "main": "dist/electron/main.cjs",
  "desktopName": "afterglow.desktop",
  "author": "w4dux",
  "repository": "github:w4dux/afterglow",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "build:bridge": "bash native/media-bridge/build.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "demo:assets": "node scripts/generate-demo.mjs",
    "package:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "measure": "node scripts/measure-sync.mjs http://127.0.0.1:5199/ docs/measurements/chromium-audio-clock.json",
    "e2e:controls": "node tests/e2e/controls-autohide.mjs",
    "e2e": "bash tests/e2e/make-fixtures.sh .e2e-fixtures && node tests/e2e/electron-smoke.mjs .e2e-fixtures .e2e-shots",
    "build:bridge:linux": "bash native/media-bridge/build.sh linux",
    "build:bridge:win": "bash native/media-bridge/build.sh windows",
    "package:linux:dir": "npm run build && electron-builder --linux dir --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "music-metadata": "^12.3.5",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "build": {
    "appId": "app.afterglow.lyrics",
    "productName": "Afterglow",
    "copyright": "Afterglow",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "artifactName": "Afterglow-${version}-win-${arch}.${ext}",
      "signExecutable": false,
      "extraResources": [
        {
          "from": "resources/bin",
          "to": "bin",
          "filter": [
            "afterglow-media-bridge.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Afterglow-Setup-${version}-x64.${ext}",
      "shortcutName": "Afterglow"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "executableName": "afterglow",
      "syncDesktopName": true,
      "synopsis": "Full-screen kinetic lyrics for the music you play",
      "description": "Afterglow shows full-screen, time-synced kinetic lyrics for Spotify and other MPRIS media players, local audio files, and an offline demo.",
      "maintainer": "w4dux <w4dux@users.noreply.github.com>",
      "artifactName": "Afterglow-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Afterglow",
          "GenericName": "Lyrics",
          "Comment": "Full-screen kinetic lyrics for the music you play",
          "Keywords": "lyrics;karaoke;spotify;music;"
        }
      },
      "extraResources": [
        {
          "from": "resources/bin",
          "to": "bin",
          "filter": [
            "afterglow-media-bridge"
          ]
        }
      ]
    },
    "electronLanguages": [
      "en-US"
    ],
    "compression": "normal",
    "deb": {
      "artifactName": "afterglow_${version}_amd64.${ext}",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "appImage": {
      "artifactName": "Afterglow-${version}-x86_64.${ext}"
    }
  }
}
